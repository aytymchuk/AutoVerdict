<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- SharpCompress (transitive via MongoDB.Driver) has no fix available as of 2026-05.
         The vulnerable WriteToDirectory() code path is not reachable through MongoDB.Driver usage. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-6c8g-7p36-r338" />
    <!-- OpenTelemetry.Api (transitive via OpenTelemetry.Instrumentation.*) — moderate severity.
         No patched version available as of 2026-06. The vulnerable code path is not exercised
         by the instrumentation usage in this project. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g94r-2vxg-569j" />
  </ItemGroup>
</Project>
